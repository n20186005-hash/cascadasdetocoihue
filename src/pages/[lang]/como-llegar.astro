---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { attraction, SITE_URL } from '../../config/attraction';
import { buildAlternates, subpageLangs } from '../../i18n/ui';
import { comoLlegar, horariosPrecios, fotos, mejorEpoca } from '../../data/subpages';

export function getStaticPaths() {
  return subpageLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as 'es' | 'en' | 'zh';
const homeLabel = { es: 'Inicio', en: 'Home', zh: '首页' }[lang];
const slug = 'como-llegar';
const c = comoLlegar[lang];
const canonical = buildAlternates(slug)[lang];
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: buildAlternates('').es },
    { '@type': 'ListItem', position: 2, name: c.h1, item: canonical },
  ],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const sisters = [
  { slug: 'horarios-precios', h1: horariosPrecios[lang].h1 },
  { slug: 'fotos', h1: fotos[lang].h1 },
  { slug: 'mejor-epoca', h1: mejorEpoca[lang].h1 },
];
---

<BaseLayout title={c.title} description={c.description} path={slug} langs={subpageLangs}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <article class="section-padding" style="background: var(--bg-primary);">
    <div class="max-w-4xl mx-auto px-4">
      <nav aria-label="Migas de pan" class="text-sm mb-6" style="color: var(--text-muted);">
        <a href={`${SITE_URL}/${lang}/`} class="hover:opacity-70" style="color: var(--accent);">{homeLabel}</a>
        <span class="mx-2">/</span>
        <span>{c.h1}</span>
      </nav>

      <h1 class="font-display text-3xl sm:text-5xl font-semibold mb-4" style="color: var(--text-primary);">{c.h1}</h1>
      <p class="text-lg leading-relaxed mb-10" style="color: var(--text-secondary);">{c.lead}</p>

      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-12 items-start">
        <div>
          <h2 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">Ruta desde Dalcahue</h2>
          <ol class="space-y-5">
            {c.fromDalcahue.map((item, index) => (
              <li class="flex gap-4">
                <span class="shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm text-white" style="background: var(--accent);">
                  {index + 1}
                </span>
                <div>
                  <p class="font-semibold mb-1" style="color: var(--text-primary);">{item.step}</p>
                  <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.detail}</p>
                </div>
              </li>
            ))}
          </ol>

          <h2 class="font-display text-2xl font-semibold mt-12 mb-6" style="color: var(--text-primary);">Cómo llegar a Chiloé y a Dalcahue</h2>
          <div class="space-y-4">
            {c.options.map((opt) => (
              <div class="rounded-2xl p-5 border" style="background: var(--card-bg); border-color: var(--border-color);">
                <p class="font-semibold mb-1" style="color: var(--text-primary);">
                  <span aria-hidden="true" class="mr-2">{opt.icon}</span>{opt.title}
                </p>
                <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{opt.text}</p>
              </div>
            ))}
          </div>
        </div>

        <aside class="space-y-6">
          <div class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
            <h3 class="font-display text-xl font-semibold mb-4" style="color: var(--text-primary);">Datos clave</h3>
            <dl class="space-y-3">
              <div class="border-b pb-3" style="border-color: var(--border-color);">
                <dt class="text-xs uppercase tracking-[0.14em]" style="color: var(--text-muted);">Distancia desde Dalcahue</dt>
                <dd class="text-sm font-semibold" style="color: var(--text-primary);">≈ 20 km por la Ruta U-48 (ripio)</dd>
              </div>
              <div class="border-b pb-3" style="border-color: var(--border-color);">
                <dt class="text-xs uppercase tracking-[0.14em]" style="color: var(--text-muted);">Coordenadas</dt>
                <dd class="text-sm font-semibold break-all" style="color: var(--text-primary);">{attraction.latitude}, {attraction.longitude}</dd>
              </div>
              <div class="border-b pb-3" style="border-color: var(--border-color);">
                <dt class="text-xs uppercase tracking-[0.14em]" style="color: var(--text-muted);">Plus Code</dt>
                <dd class="text-sm font-semibold" style="color: var(--text-primary);">{attraction.plusCode}</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-[0.14em]" style="color: var(--text-muted);">Teléfono</dt>
                <dd class="text-sm font-semibold" style="color: var(--text-primary);">{attraction.telephoneDisplay}</dd>
              </div>
            </dl>
          </div>

          <div class="rounded-2xl p-6 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
            <h3 class="font-display text-xl font-semibold mb-3" style="color: var(--text-primary);">Estacionamiento</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{c.parking}</p>
          </div>
        </aside>
      </div>

      <div id="map" class="mt-12 rounded-2xl overflow-hidden border" style="border-color: var(--border-color);">
        <iframe
          src={attraction.mapsEmbedSrc}
          title="Mapa de las Cascadas de Tocoihue"
          width="100%"
          height="360"
          style="border:0; display:block;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold mb-5" style="color: var(--text-primary);">Preguntas frecuentes</h2>
        <div class="space-y-3">
          {c.faq.map((item) => (
            <details class="group bg-white/5 rounded-xl border border-white/10 overflow-hidden">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none p-4 font-medium" style="color: var(--text-primary);">
                <span>{item.q}</span>
                <span class="shrink-0 text-xl transition-transform group-open:rotate-45" style="color: var(--accent);" aria-hidden="true">+</span>
              </summary>
              <p class="px-4 pb-4 text-base leading-relaxed" style="color: var(--text-secondary);">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Otras guías" class="mt-14 border-t pt-8" style="border-color: var(--border-color);">
        <p class="text-xs uppercase tracking-[0.18em] mb-4" style="color: var(--text-muted);">Explora otras guías</p>
        <ul class="grid sm:grid-cols-3 gap-4">
          {sisters.map((s) => (
            <li>
              <a href={`${SITE_URL}/${lang}/${s.slug}/`} class="block rounded-2xl p-5 border hover:opacity-80" style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-primary);">
                <span class="font-semibold">{s.h1}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
