---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { attraction, SITE_URL } from '../../config/attraction';
import { buildAlternates, getI18n } from '../../i18n/ui';
import { galleryImages } from '../../data/media';
import { fotos, comoLlegar, horariosPrecios, mejorEpoca, subpageCards } from '../../data/subpages';

const slug = fotos.slug;
const canonical = buildAlternates(slug).es;
const { messages } = getI18n(Astro.url);
const captions: string[] = messages.gallery?.captions ?? [];
const photoAlt: string = messages.gallery?.photoAlt ?? attraction.fullName;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_URL}/es/` },
    { '@type': 'ListItem', position: 2, name: fotos.h1, item: canonical },
  ],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: fotos.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const sisters = [comoLlegar, horariosPrecios, mejorEpoca];
const heights = ['h-72', 'h-96', 'h-80', 'h-[22rem]', 'h-64', 'h-[21rem]'];
---

<BaseLayout title={fotos.title} description={fotos.description} path={slug} i18n={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <article class="section-padding" style="background: var(--bg-primary);">
    <div class="max-w-5xl mx-auto px-4">
      <nav aria-label="Migas de pan" class="text-sm mb-6" style="color: var(--text-muted);">
        <a href={`${SITE_URL}/es/`} class="hover:opacity-70" style="color: var(--accent);">Inicio</a>
        <span class="mx-2">/</span>
        <span>{fotos.h1}</span>
      </nav>

      <h1 class="font-display text-3xl sm:text-5xl font-semibold mb-4" style="color: var(--text-primary);">{fotos.h1}</h1>
      <p class="text-lg leading-relaxed mb-10" style="color: var(--text-secondary);">{fotos.lead}</p>

      <div class="columns-1 sm:columns-2 lg:columns-3 gap-4">
        {galleryImages.map((image, index) => (
          <figure class="relative mb-4 break-inside-avoid rounded-2xl overflow-hidden border" style="border-color: var(--border-color); box-shadow: var(--card-shadow);">
            <Image
              src={image}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              format="webp"
              alt={captions[index] ? `${captions[index]} — ${attraction.fullName}, ${attraction.city}` : photoAlt}
              loading="lazy"
              decoding="async"
              class={`w-full object-cover ${heights[index % heights.length]}`}
            />
            {captions[index] && (
              <figcaption class="absolute inset-x-0 bottom-0 p-4 text-sm leading-relaxed text-white" style="background: linear-gradient(180deg, rgba(8,18,13,0) 0%, rgba(8,18,13,0.82) 100%);">
                {captions[index]}
              </figcaption>
            )}
          </figure>
        ))}
      </div>

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold mb-5" style="color: var(--text-primary);">Consejos de fotografía</h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          {fotos.tips.map((tip) => (
            <li class="flex gap-2 text-sm leading-relaxed rounded-xl p-4 border" style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-secondary);">
              <span aria-hidden="true" class="shrink-0" style="color: var(--accent);">&#9656;</span>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold mb-5" style="color: var(--text-primary);">Preguntas frecuentes</h2>
        <div class="space-y-3">
          {fotos.faq.map((item) => (
            <details class="group bg-white/5 rounded-xl border border-white/10 overflow-hidden">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none p-4 font-medium" style="color: var(--text-primary);">
                <span>{item.q}</span>
                <span class="shrink-0 text-xl transition-transform group-open:rotate-45" style="color: var(--accent);" aria-hidden="true">+</span>
              </summary>
              <p class="px-4 pb-4 text-base leading-relaxed" style="color: var(--text-secondary);">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Otras guías" class="mt-14 border-t pt-8" style="border-color: var(--border-color);">
        <p class="text-xs uppercase tracking-[0.18em] mb-4" style="color: var(--text-muted);">Explora otras guías</p>
        <ul class="grid sm:grid-cols-3 gap-4">
          {sisters.map((s) => (
            <li>
              <a href={`${SITE_URL}/es/${s.slug}/`} class="block rounded-2xl p-5 border hover:opacity-80" style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-primary);">
                <span class="text-2xl mr-2" aria-hidden="true">{subpageCards.find((c) => c.slug === s.slug)?.icon}</span>
                <span class="font-semibold">{s.h1}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
