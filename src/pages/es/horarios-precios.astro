---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../config/attraction';
import { buildAlternates } from '../../i18n/ui';
import { horariosPrecios, comoLlegar, fotos, mejorEpoca, subpageCards } from '../../data/subpages';

const slug = horariosPrecios.slug;
const canonical = buildAlternates(slug).es;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_URL}/es/` },
    { '@type': 'ListItem', position: 2, name: horariosPrecios.h1, item: canonical },
  ],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: horariosPrecios.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const sisters = [comoLlegar, fotos, mejorEpoca];
---

<BaseLayout title={horariosPrecios.title} description={horariosPrecios.description} path={slug} i18n={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <article class="section-padding" style="background: var(--bg-primary);">
    <div class="max-w-4xl mx-auto px-4">
      <nav aria-label="Migas de pan" class="text-sm mb-6" style="color: var(--text-muted);">
        <a href={`${SITE_URL}/es/`} class="hover:opacity-70" style="color: var(--accent);">Inicio</a>
        <span class="mx-2">/</span>
        <span>{horariosPrecios.h1}</span>
      </nav>

      <h1 class="font-display text-3xl sm:text-5xl font-semibold mb-4" style="color: var(--text-primary);">{horariosPrecios.h1}</h1>
      <p class="text-lg leading-relaxed mb-10" style="color: var(--text-secondary);">{horariosPrecios.lead}</p>

      <div class="grid lg:grid-cols-2 gap-12">
        <section>
          <h2 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">Horarios</h2>
          <div class="space-y-4">
            {horariosPrecios.hours.map((row) => (
              <div class="rounded-2xl p-5 border" style="background: var(--card-bg); border-color: var(--border-color);">
                <p class="text-xs uppercase tracking-[0.14em] mb-1" style="color: var(--text-muted);">{row.label}</p>
                <p class="font-semibold" style="color: var(--text-primary);">{row.value}</p>
              </div>
            ))}
          </div>

          <div class="mt-8 rounded-2xl p-6 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
            <h3 class="font-display text-xl font-semibold mb-3" style="color: var(--text-primary);">Valor de la entrada</h3>
            <p class="text-lg font-semibold mb-2" style="color: var(--accent);">{horariosPrecios.price.range}</p>
            <p class="text-sm leading-relaxed mb-4" style="color: var(--text-secondary);">{horariosPrecios.price.note}</p>
            <p class="text-xs uppercase tracking-[0.14em] mb-2" style="color: var(--text-muted);">Qué incluye</p>
            <ul class="space-y-2">
              {horariosPrecios.price.includes.map((inc) => (
                <li class="flex gap-2 text-sm" style="color: var(--text-secondary);">
                  <span aria-hidden="true" style="color: var(--accent);">&#9656;</span>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <aside class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <h3 class="font-display text-xl font-semibold mb-4" style="color: var(--text-primary);">Antes de salir</h3>
          <ul class="space-y-3 text-sm leading-relaxed" style="color: var(--text-secondary);">
            <li class="flex gap-2"><span aria-hidden="true" style="color: var(--accent);">&#9656;</span><span>El horario fijo solo aplica en temporada alta (verano); el resto del año confirma por teléfono.</span></li>
            <li class="flex gap-2"><span aria-hidden="true" style="color: var(--accent);">&#9656;</span><span>Lleva efectivo: el cobro en la entrada rural suele ser en pesos chilenos.</span></li>
            <li class="flex gap-2"><span aria-hidden="true" style="color: var(--accent);">&#9656;</span><span>El último tramo es de ripio; consulta el estado del día en Dalcahue si ha llovido.</span></li>
            <li class="flex gap-2"><span aria-hidden="true" style="color: var(--accent);">&#9656;</span><span>El sendero hasta el mirador es de dificultad baja, apto para familias.</span></li>
          </ul>
        </aside>
      </div>

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold mb-5" style="color: var(--text-primary);">Preguntas frecuentes</h2>
        <div class="space-y-3">
          {horariosPrecios.faq.map((item) => (
            <details class="group bg-white/5 rounded-xl border border-white/10 overflow-hidden">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none p-4 font-medium" style="color: var(--text-primary);">
                <span>{item.q}</span>
                <span class="shrink-0 text-xl transition-transform group-open:rotate-45" style="color: var(--accent);" aria-hidden="true">+</span>
              </summary>
              <p class="px-4 pb-4 text-base leading-relaxed" style="color: var(--text-secondary);">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Otras guías" class="mt-14 border-t pt-8" style="border-color: var(--border-color);">
        <p class="text-xs uppercase tracking-[0.18em] mb-4" style="color: var(--text-muted);">Explora otras guías</p>
        <ul class="grid sm:grid-cols-3 gap-4">
          {sisters.map((s) => (
            <li>
              <a href={`${SITE_URL}/es/${s.slug}/`} class="block rounded-2xl p-5 border hover:opacity-80" style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-primary);">
                <span class="text-2xl mr-2" aria-hidden="true">{subpageCards.find((c) => c.slug === s.slug)?.icon}</span>
                <span class="font-semibold">{s.h1}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
