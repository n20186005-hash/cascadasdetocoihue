---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const f = messages.facilities;
const items = f.items ?? [];
const distances = f.distances ?? [];
---

<section id="services" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mb-8">
      <p class="text-xs uppercase tracking-[0.2em] mb-3" style="color: var(--accent);">{f.eyebrow}</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{f.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{f.subtitle}</p>
    </div>

    <div
      class="rounded-2xl border px-5 py-4 mb-8 max-w-4xl"
      style="background: var(--card-bg); border-color: var(--border-color);"
    >
      <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
        <strong style="color: var(--text-primary);">{f.neutralityTitle}</strong> {f.neutralityNote}
      </p>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((item: any) => (
        <li
          class="rounded-3xl border p-5 flex flex-col"
          style="background: var(--card-bg); border-color: var(--border-color);"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <h3 class="font-semibold text-base leading-snug" style="color: var(--text-primary);">
              <span class="mr-1.5" aria-hidden="true">{item.icon}</span>{item.title}
            </h3>
            <span
              class="shrink-0 rounded-full px-2.5 py-1 text-[0.65rem] uppercase tracking-[0.1em] whitespace-nowrap border"
              style="background: var(--bg-tertiary); color: var(--text-muted); border-color: var(--border-color);"
            >
              {f.levels[item.level]}
            </span>
          </div>
          <p class="text-sm leading-relaxed mb-3" style="color: var(--text-secondary);">{item.text}</p>
          {item.tips?.length > 0 && (
            <ul class="mt-auto space-y-1.5 text-xs leading-relaxed" style="color: var(--text-muted);">
              {item.tips.map((tip: string) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" style="color: var(--accent);">·</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    {distances.length > 0 && (
      <div
        class="mt-8 rounded-3xl border p-6"
        style="background: var(--card-bg); border-color: var(--border-color);"
      >
        <h3 class="font-display text-lg font-semibold mb-4" style="color: var(--text-primary);">{f.distancesTitle}</h3>
        <dl class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
          {distances.map((row: any) => (
            <div>
              <dt style="color: var(--text-muted);">{row.place}</dt>
              <dd class="font-semibold mt-1" style="color: var(--text-primary);">{row.value}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs mt-4 leading-relaxed" style="color: var(--text-muted);">{f.distancesNote}</p>
      </div>
    )}

    <p class="text-xs mt-6 leading-relaxed max-w-4xl" style="color: var(--text-muted);">
      {f.maintenanceNote}
    </p>
  </div>
</section>
