---
import { Image } from 'astro:assets';
import { getI18n } from '../i18n/ui';
import { speciesImages } from '../data/media';

const { messages } = getI18n(Astro.url);
const t = messages.knowledge;
const sections = t.sections;
const speciesGuide = t.speciesGuide ?? null;
---

<section id="nature" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-6 text-center" style="color: var(--text-primary);">{t.title}</h2>
    <div class="w-12 h-0.5 mb-12 mx-auto" style="background: var(--accent);"></div>

    <div class="space-y-12">
      {sections.map((section, index) => (
        <div class={`flex flex-col md:flex-row gap-6 items-start ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''}`}>
          <div class="flex-1 w-full bg-white/5 p-8 rounded-2xl border border-white/10 shadow-sm">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg" style="background: var(--accent); color: white;">
                {index + 1}
              </div>
              <h3 class="font-display text-2xl font-semibold" style="color: var(--text-primary);">{section.title}</h3>
            </div>
            <p class="text-lg leading-relaxed ml-14" style="color: var(--text-secondary);">{section.content}</p>
          </div>
        </div>
      ))}
    </div>

    {speciesGuide?.items?.length > 0 && (
      <div class="mt-16">
        <div class="max-w-3xl mx-auto text-center mb-10">
          <p class="text-xs uppercase tracking-[0.18em] mb-3" style="color: var(--text-muted);">{speciesGuide.eyebrow}</p>
          <h3 class="font-display text-2xl sm:text-3xl font-semibold mb-3" style="color: var(--text-primary);">{speciesGuide.title}</h3>
          <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{speciesGuide.subtitle}</p>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6">
          {speciesGuide.items.map((item) => (
            <article class="rounded-2xl overflow-hidden border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
              {speciesImages[item.id] && (
                <Image
                  src={speciesImages[item.id]}
                  alt={item.name}
                  widths={[320, 480]}
                  sizes="(min-width: 1280px) 280px, (min-width: 768px) 45vw, 90vw"
                  loading="lazy"
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-5">
                <p class="text-xs uppercase tracking-[0.18em] mb-2" style="color: var(--text-muted);">{item.latin}</p>
                <h4 class="font-semibold text-lg mb-2" style="color: var(--text-primary);">{item.name}</h4>
                <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
