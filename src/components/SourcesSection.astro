---
import { getI18n } from '../i18n/ui';
import { attraction } from '../config/attraction';

const { lang, messages } = getI18n(Astro.url);
const s = messages.sources;
const items = s.items ?? [];
const country = attraction.country;
const region = attraction.stateProvince;
---

<section id="sources" class="section-padding" style="background: var(--bg-tertiary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-4" style="color: var(--text-primary);">
        {s.title}
      </h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{s.subtitle}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <div class="rounded-2xl p-6 border h-full" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
        <h3 class="font-semibold text-lg mb-4" style="color: var(--text-primary);">{s.itemsTitle}</h3>
        <ul class="space-y-4 text-sm">
          {items.map((item) => (
            <li class="border-b pb-4 last:border-b-0 last:pb-0" style="border-color: var(--border-color);">
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold hover:opacity-70 break-words"
                style="color: var(--accent);"
              >
                {item.name} ↗
              </a>
              <p class="mt-1" style="color: var(--text-muted);">{item.publisher}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-6">
        <!-- Authoritative outbound link (`.gov` / `.org` official tourism portal) -->
        <div class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <h3 class="font-semibold text-lg mb-3" style="color: var(--text-primary);">
            {country} / {region}
          </h3>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--text-secondary);">{s.officialTourism}</p>
          <a
            href={attraction.govtTourismUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex text-sm font-semibold hover:opacity-70 break-words"
            style="color: var(--accent);"
          >
            {s.officialTourismLink} ↗
          </a>
        </div>

        <!-- Image rights notice -->
        <div class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <h3 class="font-semibold text-lg mb-3" style="color: var(--text-primary);">{s.imageRightsTitle}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{s.imageRights}</p>
          <p class="text-xs mt-4" style="color: var(--text-muted);">{s.lastReviewedLabel}: {s.lastReviewed}</p>
        </div>
      </div>
    </div>
  </div>
</section>
