---
import { SITE_URL } from '../config/attraction';
import { getI18n, subpageLangs } from '../i18n/ui';
import { subpageCards } from '../data/subpages';

const { lang } = getI18n(Astro.url);
const show = subpageLangs.includes(lang);
const cards = subpageCards[lang as 'es' | 'en' | 'zh'];
---

{show && (
  <section class="section-padding" style="background: var(--bg-secondary);">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">Guías para planificar tu visita</h2>
      <p class="text-center text-lg mb-10" style="color: var(--text-secondary);">
        Información práctica para llegar, cuándo ir y qué esperar en las Cascadas de Tocoihue.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {cards.map((card) => (
          <a
            href={`${SITE_URL}/${lang}/${card.slug}/`}
            class="group rounded-2xl p-6 border flex flex-col gap-3 hover:shadow-lg transition"
            style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-primary);"
          >
            <span class="text-3xl" aria-hidden="true">{card.icon}</span>
            <span class="font-display text-xl font-semibold">{card.title}</span>
            <span class="text-sm leading-relaxed" style="color: var(--text-secondary);">{card.text}</span>
            <span class="mt-auto text-sm font-semibold" style="color: var(--accent);">Leer guía →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
